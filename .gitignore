# 依赖与构建产物
node_modules/
dist/
src-tauri/target/

# 打包好的可执行产物（安装包 / 便携 exe），不进仓库
release/

# 散落在仓库根目录的构建产物副本。
# 便携 exe / 安装包只应存在于 R:\QQ-Drawer\（scripts\build.ps1 的输出目录），
# 仓库只放源码。曾经有过一份 QQ-Drawer.exe（6.5 MB）被提交进历史，
# 已于 2026-09-20 用 git filter-branch 从整条历史中摘除。
/QQ-Drawer.exe
/QQ-Drawer-Setup.exe
/WebView2Loader.dll
*.pdb

# Tauri 每次构建都会重新生成的 capability / ACL schema
src-tauri/gen/

# 本机运行时数据（数据库、图片缓存、日志一律在 %LOCALAPPDATA%，不进仓库）
*.db
*.db-shm
*.db-wal
*.log

# 编辑器 / 系统
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db

# 环境
.env
.env.local

# 本机工作记忆（每日笔记属于本机状态，不进仓库）
.workbuddy/memory/

# 本机排障脚本（含访问 token、绝对路径，只对这台机器有意义）
.workbuddy/tmp/
