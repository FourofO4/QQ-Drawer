# 依赖与构建产物
node_modules/
dist/
src-tauri/target/

# Tauri 每次构建都会重新生成的 capability / ACL schema
src-tauri/gen/

# 本机运行时数据（数据库、图片缓存、日志一律在 %LOCALAPPDATA%，不进仓库）
*.db
*.db-shm
*.db-wal
*.log

# 编辑器 / 系统
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db

# 环境
.env
.env.local

# 本机工作记忆（每日笔记属于本机状态，不进仓库）
.workbuddy/memory/

# 本机排障脚本（含访问 token、绝对路径，只对这台机器有意义）
.workbuddy/tmp/
